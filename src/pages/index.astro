---
import { Image, getImage } from "astro:assets";
import CurlyBraceWrapper from "@/components/CurlyBraceWrapper.astro";
import Lightbox from "@/components/Lightbox.astro";
import {
  books,
  musicTracks,
  nonProfits,
  paintings,
  projects,
  studioPortraits,
  technologies,
  ukraineImages,
} from "@/data/homepage";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { resolveImage } from "@/utils/images";

import heroImage from "@/assets/images/alex/alex-sitting-in-gras-with-camera.png";
import portraitImage from "@/assets/images/alex/alex-portrait-circle.png";

// Larger versions shown in the lightbox
const lightboxSrc = async (path: string) =>
  (await getImage({ src: resolveImage(path), width: 732, format: "webp" })).src;

const portraits = await Promise.all(
  studioPortraits.map(async (portrait) => ({
    ...portrait,
    full: await lightboxSrc(portrait.src),
  })),
);

const paintingItems = await Promise.all(
  paintings.map(async (painting) => ({
    ...painting,
    full: await lightboxSrc(painting.imageUrl),
  })),
);

const thumbSizes = "(min-width: 768px) 188px, (min-width: 640px) 30vw, 45vw";
---

<BaseLayout contentClass="">
  <main class="page-padding mb-16 md:mb-32 overflow-x-clip">
    <!-- Hero -->
    <section id="hero" class="hero relative grid grid-cols-1 lg:grid-cols-2 mb-16 md:mb-32">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="flex flex-col justify-center mr-8 mb-8">
        <h1 class="headline-xl hero-title">
          Hi, I'm <span class="text-red">Alex</span>ander<span
            class="caret"
            aria-hidden="true"></span>
        </h1>
        <p class="md:text-xl mb-8 hero-fade" style="--d: 1">
          As a freelance software developer, I help you build secure,
          customer-facing software — delivered reliably and with a smile.
        </p>
        <div class="flex hero-fade" style="--d: 2">
          <a href="#contact" class="button-primary">
            Contact me
            <svg class="button-arrow" aria-hidden="true" focusable="false" viewBox="0 0 16 16">
              <path
                d="M3 8h10M9 4l4 4-4 4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>
      </div>
      <div class="flex justify-end items-center">
        <div class="hero-image">
          <Image
            src={heroImage}
            alt="Me sitting in grass with camera"
            class="object-contain"
            widths={[518, 800, 1036]}
            sizes="(min-width: 1024px) 518px, 90vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <!-- My Story -->
    <section id="my-story" class="mb-16 md:mb-32">
      <h2 class="headline reveal"><CurlyBraceWrapper>My story</CurlyBraceWrapper></h2>
      <p class="md:text-xl mb-8 reveal">I was born in Donetsk, Ukraine, in 1994:</p>
      <ul class="polaroids reveal-stagger grid grid-cols-2 lg:grid-cols-4 gap-8 mb-16 md:mb-32">
        {
          ukraineImages.map((image) => (
            <li>
              <div class="polaroid" data-swipe>
                <Image
                  src={resolveImage(image.src)}
                  alt={image.alt}
                  class="object-contain"
                  widths={[243, 486]}
                  sizes="(min-width: 1024px) 243px, 45vw"
                />
              </div>
            </li>
          ))
        }
      </ul>
      <p class="md:text-xl mb-8 reveal">
        I'm passionate about helping others — that's why I love working with
        non-profits:
      </p>
      <ul class="reveal-stagger grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16 md:mb-32">
        {
          nonProfits.map((np) => (
            <li class="card">
              <a href={np.url} target="_blank" rel="noopener" class="card-link inline-block">
                <Image
                  src={resolveImage(np.imageUrl)}
                  alt={np.name}
                  class={`object-contain object-left mb-8 inline-block h-[50px] w-auto ${np.imageClass ?? ""}`}
                  height={50}
                  densities={[1, 2]}
                />
              </a>
              <svg class="card-arrow" aria-hidden="true" focusable="false" viewBox="0 0 20 20">
                <path
                  d="M6 14L14 6M7 6h7v7"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <p>{np.description}</p>
            </li>
          ))
        }
      </ul>
      <p class="md:text-xl mb-8 reveal">
        I also love reading books! Here are some of my favorites:
      </p>
      <ul class="reveal-stagger grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-8 mb-16 md:mb-32">
        {
          books.map((book) => (
            <li>
              <a
                href={book.url}
                target="_blank"
                rel="noopener"
                title={book.title}
                class="book flex justify-center"
                data-tilt
              >
                <Image
                  src={resolveImage(book.imageUrl)}
                  alt={book.title}
                  class="object-contain"
                  widths={[188, 376]}
                  sizes={thumbSizes}
                />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="md:text-xl mb-8 reveal">
        My other obsessions include
        <a href="https://atlesque.com" class="link">photography</a>, painting and music
        production:
      </p>
      <ul class="reveal-stagger grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-8 mb-8">
        {
          portraits.map((portrait) => (
            <li class="flex justify-center">
              <button
                type="button"
                class="artwork"
                data-lightbox="portraits"
                data-full={portrait.full}
                data-swipe
              >
                <Image
                  src={resolveImage(portrait.src)}
                  alt={portrait.alt}
                  class="object-contain"
                  widths={[188, 376]}
                  sizes={thumbSizes}
                />
              </button>
            </li>
          ))
        }
      </ul>
      <ul class="reveal-stagger grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-8 mb-8">
        {
          paintingItems.map((painting) => (
            <li class="flex justify-center">
              <button
                type="button"
                class="artwork artwork--glow"
                data-lightbox="paintings"
                data-full={painting.full}
                title={painting.title}
                data-swipe
              >
                <Image
                  src={resolveImage(painting.imageUrl)}
                  alt={`Painting entitled ${painting.title}`}
                  class="object-contain"
                  widths={[188, 376]}
                  sizes={thumbSizes}
                />
              </button>
            </li>
          ))
        }
      </ul>
      <div class="reveal-stagger">
        {
          musicTracks.map((track) => (
            <div class="track mb-8 last:mb-0">
              <span class="equalizer" aria-hidden="true">
                <span />
                <span />
                <span />
                <span />
              </span>
              <audio controls preload="metadata" class="w-full">
                <source src={track.url} type="audio/mpeg" />
              </audio>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Career -->
    <section id="career" class="mb-16 md:mb-32">
      <h2 class="headline reveal">
        <CurlyBraceWrapper>Career</CurlyBraceWrapper>
      </h2>
      <div class="timeline">
        <p class="md:text-xl mb-8 reveal">
          I hold a
          <span class="highlight">Bachelor's degree in Computer Science</span>
          and I'm a <span class="highlight">Certified Ethical Hacker</span>.
        </p>
        <p class="md:text-xl mb-8 reveal">
          I've taught <span class="highlight">Digital Forensics</span> to the
          Federal Computer Crime Unit of the
          <span class="highlight">Belgian police</span>.
        </p>
        <p class="md:text-xl mb-8 reveal">
          I've given
          <span class="highlight">talks on Internet-of-Things security</span>
          and digital safety.
        </p>
        <p class="md:text-xl mb-8 reveal">
          During my internship in Osaka, <span class="highlight">Japan</span>, I
          helped launch a cross-platform app for children that reached
          <a
            class="link"
            href="/images/others/night-zookeeper-appstore-2015.png"
            target="_blank"
            >first place in the Apple App Store</a
          >.
        </p>
        <p class="md:text-xl mb-8 reveal">
          I founded my own company, <span class="highlight">Atlesque</span>, in
          2017. Four years later, my father joined me to expand our content
          creation services under
          <a class="link" href="https://atlesque.media">Atlesque Media</a>.
        </p>
      </div>
    </section>

    <!-- Expertise -->
    <section id="expertise" class="mb-16 md:mb-32">
      <h2 class="headline reveal">
        <CurlyBraceWrapper>Expertise</CurlyBraceWrapper>
      </h2>
      <p class="md:text-xl mb-8 reveal">
        My favorite programming languages & frameworks are:
      </p>
      <ul class="reveal-stagger grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-8 mb-16 md:mb-32">
        {
          technologies.map((tech) => (
            <li class="tech flex items-center justify-center">
              <Image
                src={resolveImage(tech.imageUrl)}
                alt={tech.name}
                title={tech.name}
                class="object-contain"
                width={150}
                densities={[1, 2]}
              />
            </li>
          ))
        }
      </ul>
      <p class="md:text-xl mb-8 reveal">
        I've helped build commercial and open-source projects including:
      </p>
      <ul class="reveal-stagger grid grid-cols-1 lg:grid-cols-2 gap-8 mb-16 md:mb-32">
        {
          projects.map((project) => (
            <li class="card">
              <a
                href={project.url}
                target="_blank"
                rel="noopener"
                class="card-link flex items-center gap-4 mb-8"
              >
                <Image
                  src={resolveImage(project.imageUrl)}
                  alt={project.showTitle ? "" : project.name}
                  class={`object-contain object-left inline-block h-[30px] w-auto ${project.imageClass ?? ""}`}
                  height={30}
                  densities={[1, 2]}
                />
                {project.showTitle && <span class="font-medium text-lg">{project.name}</span>}
              </a>
              <svg class="card-arrow" aria-hidden="true" focusable="false" viewBox="0 0 20 20">
                <path
                  d="M6 14L14 6M7 6h7v7"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <p>{project.description}</p>
            </li>
          ))
        }
      </ul>
      <p class="md:text-xl mb-8 reveal">
        I've been writing code since I was 10 — professionally since 2015.
      </p>
      <p class="md:text-xl mb-8 reveal">
        I speak Dutch, English and Russian fluently, and I get by in French and
        Japanese too.
      </p>
      <p class="md:text-xl mb-8 reveal">
        I also offer extra services like copywriting, photo & video, teaching
        and audio production.
      </p>
    </section>

    <!-- Contact -->
    <section id="contact">
      <h2 class="headline reveal">
        <CurlyBraceWrapper>Contact me</CurlyBraceWrapper>
      </h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <div class="reveal">
          <p class="md:text-xl mb-8">
            Whether you're looking for a flexible extra pair of hands, a business
            partner or a philanthropic friend, I'm here to help!
          </p>
          <p class="md:text-xl mb-8">
            Happy to connect over video, phone or a cup of tea in Bruges,
            Belgium!
          </p>
          <p class="md:text-xl mb-8">
            Looking forward to creating value in the world together! 🙏
          </p>
        </div>
        <div class="contact-links reveal" style="--i: 2">
          <address class="flex flex-col gap-6 items-start not-italic">
            <a href="mailto:alexander@atlesque.media" class="button-primary"
              >alexander@atlesque.media</a
            >
            <a
              href="https://www.linkedin.com/in/alexandervanmaele/"
              target="_blank"
              rel="noopener"
              class="button-primary"
              >LinkedIn</a
            >
            <a
              href="https://atlesque.com/"
              target="_blank"
              rel="noopener"
              class="button-primary"
              >Photography portfolio</a
            >
          </address>
          <div class="portrait">
            <svg class="portrait-ring" aria-hidden="true" focusable="false" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="0.6" stroke-dasharray="2 3"></circle>
            </svg>
            <Image
              src={portraitImage}
              alt="Portrait of me"
              class="relative w-full h-auto"
              width={278}
              densities={[1, 2]}
            />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Lightbox />
</BaseLayout>


<style>
  /* ---------- Hero ---------- */
  .hero-grid {
    position: absolute;
    inset: -4rem -2.5rem -2rem;
    z-index: -1;
    background-image: radial-gradient(rgb(14 10 6 / 16%) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 60% 70% at 70% 45%, #000 20%, transparent 75%);
    pointer-events: none;
  }

  .caret {
    display: inline-block;
    width: 0.08em;
    height: 0.9em;
    margin-left: 0.12em;
    vertical-align: -0.08em;
    background: theme("colors.red");
    border-radius: 1px;
  }

  .hero-image {
    position: relative;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  /* Offset frame behind the hero photo */
  .hero-image::before {
    content: "";
    position: absolute;
    inset: 0;
    border: 2px solid theme("colors.red");
    border-radius: 1rem 0.25rem 1rem 1rem;
    transform: translate(14px, 14px);
    transition: transform var(--dur-slow) var(--ease-out);
    z-index: -1;
  }

  .hero-image :global(img) {
    border-radius: 1rem 0.25rem 1rem 1rem;
  }

  .hero-image:hover {
    transform: translate(-3px, -3px);
  }

  .hero-image:hover::before {
    transform: translate(19px, 19px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: blink 1.6s var(--ease-in-out) infinite;
    }

    :global(.js) .hero-fade {
      animation: fade-up 1.3s var(--ease-out) both;
      animation-delay: calc(0.2s + var(--d, 0) * 180ms);
    }

    .hero-title {
      animation: rise 1.3s var(--ease-out) both;
    }

    .hero-image {
      animation: rise 1.5s var(--ease-out) 0.15s both;
    }

    .hero-image::before {
      animation: frame-in 1.6s var(--ease-out) 0.5s both;
    }
  }

  @keyframes blink {
    0%,
    35% {
      opacity: 1;
    }

    55%,
    85% {
      opacity: 0;
    }
  }

  /* Transform-only so the LCP element paints immediately */
  @keyframes rise {
    from {
      transform: translateY(12px);
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes frame-in {
    from {
      transform: translate(0, 0);
      opacity: 0;
    }
  }

  /* ---------- Draggable photos ---------- */
  :global(.swipeable) {
    position: relative;
    touch-action: pan-y;
    user-select: none;
    -webkit-touch-callout: none;
  }

  :global(.swipeable.is-dragging) {
    z-index: 20;
    cursor: grabbing;
  }

  /* ---------- Polaroids ---------- */
  .polaroid {
    @apply bg-white p-3 pb-8 cursor-grab;

    box-shadow:
      0 1px 2px rgb(14 10 6 / 8%),
      0 12px 28px -14px rgb(14 10 6 / 35%);
    transform: rotate(var(--rot, -2deg));
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .polaroids li:nth-child(2n) {
    --rot: 2.5deg;
  }

  .polaroids li:nth-child(3n) {
    --rot: -1deg;
  }

  .polaroid:hover,
  .polaroid:global(.is-dragging) {
    transform: rotate(0deg) translateY(-4px) scale(1.02);
    box-shadow:
      0 1px 2px rgb(14 10 6 / 8%),
      0 24px 40px -18px rgb(14 10 6 / 40%);
  }

  .polaroid:global(.is-dragging) {
    box-shadow:
      0 1px 2px rgb(14 10 6 / 8%),
      0 34px 50px -20px rgb(14 10 6 / 45%);
  }

  /* ---------- Books ---------- */
  .book {
    perspective: 900px;
  }

  /* Tilt and lift are eased per frame from JS on pointer devices */
  .book :global(img) {
    border-radius: 2px 6px 6px 2px;
    box-shadow: 0 10px 24px -12px rgb(14 10 6 / 45%);
    transform: rotateX(calc(var(--rx, 0) * 1deg)) rotateY(calc(var(--ry, 0) * 1deg))
      translateY(calc(var(--lift, 0) * -5px)) scale(calc(1 + var(--lift, 0) * 0.03));
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .book:global(.is-smoothing) :global(img) {
    transition: box-shadow var(--dur) var(--ease-out);
  }

  .book:not(:global(.has-smooth-tilt)):hover :global(img),
  .book:focus-visible :global(img) {
    --ry: -10;
    --lift: 1;
  }

  .book:hover :global(img),
  .book:focus-visible :global(img) {
    box-shadow: 0 22px 32px -16px rgb(14 10 6 / 50%);
  }

  .book:focus-visible {
    outline: none;
  }

  .book:focus-visible :global(img) {
    @apply outline outline-2 outline-offset-4 outline-red-dark;
  }

  /* ---------- Portraits & paintings ---------- */
  .artwork {
    @apply block overflow-hidden rounded-lg cursor-zoom-in;

    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }

  .artwork :global(img) {
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .artwork:hover,
  .artwork:focus-visible,
  .artwork:global(.is-dragging) {
    transform: translateY(-3px);
    box-shadow: 0 18px 30px -18px rgb(14 10 6 / 50%);
  }

  .artwork:hover :global(img),
  .artwork:focus-visible :global(img) {
    transform: scale(1.04);
  }

  .artwork--glow:hover,
  .artwork--glow:focus-visible {
    box-shadow:
      0 18px 30px -18px rgb(14 10 6 / 50%),
      0 0 36px -8px rgb(243 102 91 / 45%);
  }

  /* ---------- Music ---------- */
  .track {
    @apply flex items-center gap-4 rounded-full bg-gray-extra-light pl-5 pr-1 py-1;

    border: 1px solid transparent;
    transition: border-color var(--dur) ease;
  }

  .track:hover,
  .track:focus-within,
  .track:global(.is-playing) {
    @apply border-gray-light;
  }

  .equalizer {
    @apply flex items-end gap-[3px] h-5 shrink-0;
  }

  /* Bar levels come from an audio analyser while the track plays */
  .equalizer span {
    @apply block w-[3px] h-full rounded-full bg-red;

    transform: scaleY(var(--level, 0.25));
    transform-origin: bottom;
  }

  /* Fallback when the Web Audio API is unavailable */
  @media (prefers-reduced-motion: no-preference) {
    .track:global(.is-playing.no-analyser) .equalizer span {
      animation: eq 1.6s var(--ease-in-out) infinite alternate;
    }

    .track:global(.no-analyser) .equalizer span:nth-child(2) {
      animation-delay: -0.5s;
    }

    .track:global(.no-analyser) .equalizer span:nth-child(3) {
      animation-delay: -1s;
    }

    .track:global(.no-analyser) .equalizer span:nth-child(4) {
      animation-delay: -0.25s;
    }
  }

  @keyframes eq {
    0% {
      transform: scaleY(0.25);
    }

    50% {
      transform: scaleY(1);
    }

    100% {
      transform: scaleY(0.45);
    }
  }

  /* ---------- Career timeline ---------- */
  .timeline {
    @apply relative pl-8;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 0.6rem;
    bottom: 2.6rem;
    width: 2px;
    background: linear-gradient(theme("colors.red"), theme("colors.blue"));
    opacity: 0.35;
    border-radius: 2px;
  }

  .timeline > p {
    position: relative;
  }

  .timeline > p::before {
    content: "";
    position: absolute;
    left: calc(-2rem + 1px);
    top: 0.6em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: theme("colors.white");
    border: 2px solid theme("colors.red");
    transition:
      background-color var(--dur) ease,
      transform var(--dur) var(--ease-out);
  }

  .timeline > p:hover::before {
    background: theme("colors.red");
    transform: scale(1.2);
  }

  /* ---------- Technologies ---------- */
  .tech {
    @apply rounded-2xl p-4;

    transition:
      transform var(--dur) var(--ease-out),
      background-color var(--dur) ease;
  }

  .tech :global(img) {
    transition: transform var(--dur) var(--ease-out);
  }

  .tech:hover {
    @apply bg-gray-extra-light;

    transform: translateY(-3px);
  }

  .tech:hover :global(img) {
    transform: scale(1.04);
  }

  /* ---------- Contact ---------- */

  /* Buttons and portrait sit side by side and wrap rather than overlap */
  .contact-links {
    @apply flex flex-wrap items-center gap-x-12 gap-y-10;
  }

  .portrait {
    @apply relative shrink-0 w-48 md:w-56 m-3;
  }

  .portrait-ring {
    @apply absolute text-red;

    inset: -6%;
    width: 112%;
    height: 112%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .portrait-ring {
      animation: spin 90s linear infinite;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const audios = document.querySelectorAll<HTMLAudioElement>(".track audio");
  const AudioContextClass =
    window.AudioContext ??
    (window as Window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
  let context: AudioContext | null = null;

  // Frequency bands as FFT bin ranges (~86 Hz each): bass, low-mid, high-mid, treble
  const BANDS: [number, number][] = [
    [1, 4],
    [4, 12],
    [12, 32],
    [32, 80],
  ];
  const REST = 0.25;

  interface Meter {
    analyser: AnalyserNode;
    data: Uint8Array<ArrayBuffer>;
    bars: HTMLElement[];
    levels: number[];
    peaks: number[];
    floors: number[];
    playing: boolean;
  }
  const meters = new Map<HTMLAudioElement, Meter>();
  let frame = 0;

  function connect(audio: HTMLAudioElement): Meter | null {
    if (meters.has(audio)) return meters.get(audio)!;
    if (!AudioContextClass || reducedMotion.matches) return null;
    try {
      context ??= new AudioContextClass();
      const source = context.createMediaElementSource(audio);
      const analyser = context.createAnalyser();
      analyser.fftSize = 512;
      analyser.smoothingTimeConstant = 0.8;
      source.connect(analyser);
      analyser.connect(context.destination);
      const meter: Meter = {
        analyser,
        data: new Uint8Array(analyser.frequencyBinCount),
        bars: [...audio.closest(".track")!.querySelectorAll<HTMLElement>(".equalizer span")],
        levels: BANDS.map(() => REST),
        peaks: BANDS.map(() => 0.2),
        floors: BANDS.map(() => 0),
        playing: false,
      };
      meters.set(audio, meter);
      return meter;
    } catch {
      return null;
    }
  }

  function render() {
    let active = false;
    meters.forEach((meter) => {
      meter.analyser.getByteFrequencyData(meter.data);
      BANDS.forEach(([from, to], i) => {
        let sum = 0;
        for (let bin = from; bin < to; bin++) sum += meter.data[bin];
        const raw = sum / (to - from) / 255;
        // Auto-range each band between a slowly rising floor and a slowly
        // decaying peak, so every bar follows the dynamics of its own band
        meter.peaks[i] = Math.max(raw, meter.peaks[i] * 0.995, 0.05);
        meter.floors[i] =
          raw < meter.floors[i] ? raw : meter.floors[i] + (raw - meter.floors[i]) * 0.01;
        const range = meter.peaks[i] - meter.floors[i] + 0.02;
        const energy = Math.max(0, Math.min(1, (raw - meter.floors[i]) / range));
        const target = meter.playing ? REST * 0.6 + (1 - REST * 0.6) * energy : REST;
        // Rise a little quicker than fall, both eased, so the bars breathe
        const ease = target > meter.levels[i] ? 0.25 : 0.1;
        meter.levels[i] += (target - meter.levels[i]) * ease;
        meter.bars[i].style.setProperty("--level", meter.levels[i].toFixed(3));
        if (meter.playing || Math.abs(meter.levels[i] - REST) > 0.005) active = true;
      });
    });
    frame = active ? requestAnimationFrame(render) : 0;
  }

  audios.forEach((audio) => {
    const track = audio.closest(".track")!;
    audio.addEventListener("play", () => {
      // Only one track playing at a time
      audios.forEach((other) => other !== audio && other.pause());
      track.classList.add("is-playing");
      const meter = connect(audio);
      if (!meter) {
        track.classList.add("no-analyser");
        return;
      }
      context?.resume();
      meter.playing = true;
      if (!frame) frame = requestAnimationFrame(render);
    });
    ["pause", "ended"].forEach((event) =>
      audio.addEventListener(event, () => {
        track.classList.remove("is-playing");
        const meter = meters.get(audio);
        if (meter) meter.playing = false;
      }),
    );
  });
</script>
