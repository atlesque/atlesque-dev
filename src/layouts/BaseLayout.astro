---
import "@/styles/tailwind.css";
import "@/styles/global.scss";
import TheHeader from "@/components/TheHeader.astro";
import TheFooter from "@/components/TheFooter.astro";
import { SEO_TITLE, SEO_DESCRIPTION, SITE_URL } from "@/consts";

interface Props {
  /** Additional class for the content wrapper. Defaults to "page" for standard padding. */
  contentClass?: string;
  /** Page title for the browser tab. Appended to SEO_TITLE. */
  title?: string;
  /** Page-specific meta description. Falls back to SEO_DESCRIPTION. */
  description?: string;
  /** Page-specific OG image. Falls back to default. */
  ogImage?: string;
}

const {
  contentClass = "page",
  title,
  description = SEO_DESCRIPTION,
  ogImage = `${SITE_URL}/og-image.jpg`,
} = Astro.props;

const fullTitle = title ? `${title} | Freelance Software Developer` : SEO_TITLE;
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#ffffff" />

    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalUrl} />

    <!-- Enables progressive-enhancement animations; content stays visible without JS -->
    <script is:inline>document.documentElement.classList.add("js");</script>

    <!-- Preload the fonts used above the fold -->
    <link
      rel="preload"
      href="/fonts/montserrat/subset-Montserrat-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/montserrat/subset-Montserrat-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/libre-baskerville/subset-LibreBaskerville-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="atlesque.dev" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  </head>
  <body>
    <TheHeader />
    <div class="pt-[98px]">
      <div class={contentClass}>
        <slot />
      </div>
    </div>
    <TheFooter />

    <script>
      import { smoothProps } from "@/scripts/smooth";
      import { swipeable } from "@/scripts/swipe";

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");

      // Reveal elements as they scroll into view
      const revealables = document.querySelectorAll(".reveal, .reveal-stagger");
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
        );
        revealables.forEach((el) => observer.observe(el));
      } else {
        revealables.forEach((el) => el.classList.add("is-visible"));
      }

      // Tinder-style drag on photos
      document.querySelectorAll<HTMLElement>("[data-swipe]").forEach((el) => swipeable(el));

      if (finePointer.matches && !reducedMotion.matches) {
        // Spotlight that glides after the pointer on cards
        document.querySelectorAll<HTMLElement>(".card").forEach((card) => {
          const set = smoothProps(card, { "--px": 0, "--py": -320 }, { ease: 0.12 });
          card.addEventListener("pointerenter", (e) => {
            const rect = card.getBoundingClientRect();
            // Start from the entry point so the light doesn't sweep in from afar
            set({ "--px": e.clientX - rect.left, "--py": e.clientY - rect.top }, true);
          });
          card.addEventListener("pointermove", (e) => {
            const rect = card.getBoundingClientRect();
            set({ "--px": e.clientX - rect.left, "--py": e.clientY - rect.top });
          });
        });

        // Gentle magnetic pull on buttons
        document.querySelectorAll<HTMLElement>(".button, .button-primary").forEach((button) => {
          const set = smoothProps(button, { "--mx": 0, "--my": 0 }, { ease: 0.08 });
          button.addEventListener("pointermove", (e) => {
            const rect = button.getBoundingClientRect();
            set({
              "--mx": (e.clientX - rect.left - rect.width / 2) * 0.1,
              "--my": (e.clientY - rect.top - rect.height / 2) * 0.2,
            });
          });
          button.addEventListener("pointerleave", () => set({ "--mx": 0, "--my": 0 }));
        });

        // 3D tilt and lift for elements marked with data-tilt
        document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
          const set = smoothProps(el, { "--rx": 0, "--ry": 0, "--lift": 0 }, { unit: "", ease: 0.08 });
          el.classList.add("has-smooth-tilt");
          el.addEventListener("pointermove", (e) => {
            const rect = el.getBoundingClientRect();
            const x = (e.clientX - rect.left) / rect.width - 0.5;
            const y = (e.clientY - rect.top) / rect.height - 0.5;
            set({ "--ry": x * 14, "--rx": y * -14, "--lift": 1 });
          });
          el.addEventListener("pointerleave", () => set({ "--rx": 0, "--ry": 0, "--lift": 0 }));
        });
      }
    </script>
  </body>
</html>
