<span class="braces inline whitespace-nowrap">
  <span class="brace brace-open text-red" aria-hidden="true">&lcub;&lcub;</span>
  <slot />
  <span class="brace brace-close text-red" aria-hidden="true">&rcub;&rcub;</span>
</span>

<style>
  .brace {
    display: inline-block;
    transition:
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.6s ease;
  }

  /* Braces "close in" around the heading when it is revealed */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js .reveal) .brace-open {
      transform: translateX(0.75em);
      opacity: 0;
    }

    :global(.js .reveal) .brace-close {
      transform: translateX(-0.75em);
      opacity: 0;
    }

    :global(.js .reveal.is-visible) .brace {
      transform: none;
      opacity: 1;
      transition-delay: 0.15s;
    }

    :global(.reveal.is-visible:hover) .brace-open {
      transform: translateX(-0.2em);
    }

    :global(.reveal.is-visible:hover) .brace-close {
      transform: translateX(0.2em);
    }
  }
</style>
